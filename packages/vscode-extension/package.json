{
  "name": "sweep-aicleaner",
  "displayName": "Sweep — AI Tools Cleaner",
  "description": "Scan and clean Antigravity, Codex, Claude Code, Windsurf, Kiro, and Trae caches vs conversations.",
  "version": "1.0.1",
  "publisher": "sweep",
  "repository": {
    "type": "git",
    "url": "https://github.com/L1r1h28/Sweep-agentcli-ide-cleaner"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sweep.scan",
        "title": "Scan storage",
        "category": "Sweep",
        "icon": "$(search)"
      },
      {
        "command": "sweep.expandAll",
        "title": "Expand all",
        "category": "Sweep",
        "icon": "$(expand-all)"
      },
      {
        "command": "sweep.collapseAll",
        "title": "Collapse all",
        "category": "Sweep",
        "icon": "$(collapse-all)"
      },
      {
        "command": "sweep.cleanCacheForTool",
        "title": "Clean cache for this tool",
        "category": "Sweep",
        "icon": "$(trash)"
      },
      {
        "command": "sweep.cleanConversationsForTool",
        "title": "Clean conversations for this tool",
        "category": "Sweep",
        "icon": "$(warning)"
      },
      {
        "command": "sweep.cleanCache",
        "title": "Clean all cache (safe)",
        "category": "Sweep",
        "icon": "$(trash)"
      },
      {
        "command": "sweep.cleanConversations",
        "title": "Clean all conversations (destructive)",
        "category": "Sweep",
        "icon": "$(warning)"
      },
      {
        "command": "sweep.dryRun",
        "title": "Dry-run all",
        "category": "Sweep",
        "icon": "$(eye)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sweep",
          "title": "Sweep",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sweep": [
        {
          "id": "sweep.tools",
          "name": "AI tool storage"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sweep.scan",
          "when": "view == sweep.tools",
          "group": "navigation@1"
        },
        {
          "command": "sweep.expandAll",
          "when": "view == sweep.tools",
          "group": "navigation@2"
        },
        {
          "command": "sweep.collapseAll",
          "when": "view == sweep.tools",
          "group": "navigation@3"
        },
        {
          "command": "sweep.cleanCache",
          "when": "view == sweep.tools",
          "group": "navigation@4"
        },
        {
          "command": "sweep.cleanConversations",
          "when": "view == sweep.tools",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "sweep.cleanCacheForTool",
          "when": "view == sweep.tools && viewItem =~ /^tool:/",
          "group": "inline@1"
        },
        {
          "command": "sweep.cleanConversationsForTool",
          "when": "view == sweep.tools && viewItem =~ /^tool:/",
          "group": "inline@2"
        }
      ]
    }
  },
  "license": "MIT",
  "author": "L1r1h28",
  "dependencies": {
    "@aicleaner/core": "*"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "pack": "npm run build && npx @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
