{
  "name": "sweep-aicleaner",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.1.6",
  "publisher": "L1r1h28",
  "repository": {
    "type": "git",
    "url": "https://github.com/L1r1h28/Sweep-agentcli-ide-cleaner"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "l10n": "./l10n",
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sweep.scan",
        "title": "%command.scan.title%",
        "category": "Sweep",
        "icon": "$(refresh)"
      },
      {
        "command": "sweep.cleanCacheForTool",
        "title": "%command.cleanCacheForTool.title%",
        "category": "Sweep",
        "icon": "$(trash)"
      },
      {
        "command": "sweep.cleanConversationsForTool",
        "title": "%command.cleanConversationsForTool.title%",
        "category": "Sweep",
        "icon": "$(warning)"
      },
      {
        "command": "sweep.cleanCache",
        "title": "%command.cleanCache.title%",
        "category": "Sweep",
        "icon": "$(trash)"
      },
      {
        "command": "sweep.cleanConversations",
        "title": "%command.cleanConversations.title%",
        "category": "Sweep",
        "icon": "$(warning)"
      },
      {
        "command": "sweep.dryRun",
        "title": "%command.dryRun.title%",
        "category": "Sweep",
        "icon": "$(eye)"
      },
      {
        "command": "sweep.cleanSessionsOlderThan",
        "title": "%command.cleanSessionsOlderThan.title%",
        "category": "Sweep",
        "icon": "$(history)"
      },
      {
        "command": "sweep.cleanLargeSessions",
        "title": "%command.cleanLargeSessions.title%",
        "category": "Sweep",
        "icon": "$(flame)"
      },
      {
        "command": "sweep.pickSessionsToClean",
        "title": "%command.pickSessionsToClean.title%",
        "category": "Sweep",
        "icon": "$(checklist)"
      },
      {
        "command": "sweep.exportSession",
        "title": "%command.exportSession.title%",
        "category": "Sweep",
        "icon": "$(export)"
      },
      {
        "command": "sweep.cleanSingleSession",
        "title": "%command.cleanSingleSession.title%",
        "category": "Sweep",
        "icon": "$(trash)"
      },
      {
        "command": "sweep.listBackups",
        "title": "%command.listBackups.title%",
        "category": "Sweep",
        "icon": "$(archive)"
      },
      {
        "command": "sweep.restoreBackup",
        "title": "%command.restoreBackup.title%",
        "category": "Sweep",
        "icon": "$(history)"
      },
      {
        "command": "sweep.openBackupFolder",
        "title": "%command.openBackupFolder.title%",
        "category": "Sweep",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sweep.pruneBackups",
        "title": "%command.pruneBackups.title%",
        "category": "Sweep",
        "icon": "$(clear-all)"
      },
      {
        "command": "sweep.addToWhitelist",
        "title": "%command.addToWhitelist.title%",
        "category": "Sweep",
        "icon": "$(shield)"
      },
      {
        "command": "sweep.removeFromWhitelist",
        "title": "%command.removeFromWhitelist.title%",
        "category": "Sweep",
        "icon": "$(shield-x)"
      },
      {
        "command": "sweep.openConfigFile",
        "title": "%command.openConfigFile.title%",
        "category": "Sweep",
        "icon": "$(gear)"
      }
    ],
    "configuration": {
      "title": "Sweep AI Cleaner",
      "properties": {
        "sweep.customPaths": {
          "type": "object",
          "default": {},
          "description": "Custom storage paths for AI tools (e.g. { \"claude-code\": [\"D:\\\\custom\\\\.claude\"] })."
        },
        "sweep.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns of session files or directories to protect from deletion (e.g. [\"**/keep-*/**\"])."
        },
        "sweep.whitelistProjects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of workspace/project names permanently protected from conversation cleanup."
        },
        "sweep.backupBeforeClean": {
          "type": "boolean",
          "default": true,
          "description": "Automatically backup conversation sessions to ~/.sweep/backups/ before deletion."
        },
        "sweep.hideUninstalledTools": {
          "type": "boolean",
          "default": true,
          "description": "Hide AI tools that are not installed on this machine or have 0 bytes of data."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sweep",
          "title": "Sweep",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sweep": [
        {
          "id": "sweep.tools",
          "name": "%views.tools.name%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sweep.scan",
          "when": "view == sweep.tools",
          "group": "navigation@1"
        },
        {
          "command": "sweep.cleanCache",
          "when": "view == sweep.tools",
          "group": "navigation@2"
        },
        {
          "command": "sweep.cleanConversations",
          "when": "view == sweep.tools",
          "group": "navigation@3"
        },
        {
          "command": "sweep.cleanSessionsOlderThan",
          "when": "view == sweep.tools",
          "group": "1_actions@1"
        },
        {
          "command": "sweep.cleanLargeSessions",
          "when": "view == sweep.tools",
          "group": "1_actions@2"
        },
        {
          "command": "sweep.pickSessionsToClean",
          "when": "view == sweep.tools",
          "group": "1_actions@3"
        },
        {
          "command": "sweep.listBackups",
          "when": "view == sweep.tools",
          "group": "2_backups@1"
        },
        {
          "command": "sweep.restoreBackup",
          "when": "view == sweep.tools",
          "group": "2_backups@2"
        },
        {
          "command": "sweep.pruneBackups",
          "when": "view == sweep.tools",
          "group": "2_backups@3"
        },
        {
          "command": "sweep.openConfigFile",
          "when": "view == sweep.tools",
          "group": "3_config@1"
        }
      ],
      "view/item/context": [
        {
          "command": "sweep.cleanCacheForTool",
          "when": "view == sweep.tools && viewItem =~ /^tool:/",
          "group": "inline@1"
        },
        {
          "command": "sweep.cleanConversationsForTool",
          "when": "view == sweep.tools && viewItem =~ /^tool:/",
          "group": "inline@2"
        },
        {
          "command": "sweep.exportSession",
          "when": "view == sweep.tools && viewItem =~ /^sessionEntry/",
          "group": "inline@1"
        },
        {
          "command": "sweep.cleanSingleSession",
          "when": "view == sweep.tools && viewItem == sessionEntry",
          "group": "inline@2"
        },
        {
          "command": "sweep.addToWhitelist",
          "when": "view == sweep.tools && (viewItem == sessionEntry || viewItem == pathEntry)",
          "group": "whitelist@1"
        },
        {
          "command": "sweep.removeFromWhitelist",
          "when": "view == sweep.tools && (viewItem == sessionEntry:whitelisted || viewItem == pathEntry:whitelisted)",
          "group": "whitelist@1"
        }
      ]
    }
  },
  "license": "MIT",
  "author": "L1r1h28",
  "dependencies": {
    "@aicleaner/core": "*"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "pack": "npm run build && npx @vscode/vsce package --no-dependencies --allow-missing-repository",
    "l10n:export": "npx @vscode/l10n-dev export --outDir ./l10n ./src"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/l10n-dev": "^0.0.35",
    "esbuild": "^0.25.0"
  }
}
